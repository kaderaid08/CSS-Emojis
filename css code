*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

.container{
    display:flex;
    flex-direction:column;
    width:100%;
    background-color:rgb(230, 211, 248);
    height:100%;
}

.box{
    flex: 1;
    background-color:#ffffff;
    border:2px solid rgb(148, 55, 167);
    margin:10px;
    border-radius:20px;
    /* display:flex; */
}
.b1{
    min-height:500px;
    
}
.b2{
    min-height:500px;

}
.b3{
    min-height: 500px;
    /* display: flex;
    flex-flow: row wrap; */
    /* gap: 150px; */
}

.facebox{
    padding-top: 80px;
    display: flex;
    justify-content: space-evenly;
    position: relative;
    align-items: center;
    flex-wrap: wrap;
}
/** first emoji **/
.emoji1{
    display:flex;
    position: relative;
    width: 250px;
    height: 250px;
    justify-content: center;
    align-items: center;
}
.face1{
    position:relative;
    
    display:flex;
    flex-direction:column;
    height:200px;
    width:200px;
    overflow:hidden;
    background-image: radial-gradient(#feca3e 58%, #ff8000 80%);
    border-radius:50%;
    box-shadow:30px 30px 35px rgba(0,0,0,0.25);
    transition:top 5s;
}
.eye{
    top:20%;
    
    display:flex;
    flex-direction:row;
    height:60px;
    width:50px;
    background-color:black;
    border: black 5px;
    border-radius:40px;
    position:absolute;
}
.eye1{
    left:10%;
    transition: top 5s;
}
.eye2{
    right: 10%;
    transition: top 5s;
}
.mouth{
    outline:5px solid none;
    position:absolute;
    width:100px;
    height:70px;
    top:60%;
    left:26%;
    overflow:hidden;
    transition: top 5s;
}
.left{
    top:-70%;
    left:45%;
    display:flex;
    flex-direction:row;
    height:70px;
    width:70px;
    background-color:none;
    border: black 5px;
    border-style:solid;
    border-radius:40px;
    position:absolute;
}
.right{
    top:-70%;
    right:45%;
    display:flex;
    flex-direction:row;
    height:70px;
    width:70px;
    background-color:none;
    border: black 5px;
    border-style:solid;
    border-radius:40px;
    position:absolute;
}
.completehat{
    position:absolute;
    top:-10%;
    left:19.5%;

}
.hat{
    background-color:none;
    height:90px;
    width: 150px;
    position:absolute;
    top:28%;
    left:19.5%;
    border-radius:100px;
    overflow:hidden;
}
.brim{
    background-color:rgb(0, 0, 255);
    height:43px;
    width: 175px;
    position:absolute;
    left:-13px;
    top:50px;
    border-radius:100px;
}
.color1{
    background-color:rgb(204, 0, 0);
    height:90px;
    width: 70px;
    position:absolute;
    left:-5%;
    border-radius:10px;
}
.color2{
    background-color:rgb(5, 141, 5);
    height:100px;
    width: 150px;
    position:absolute;
    left:2%;
    border-radius:1px;   
}
.color3{
    background-color:rgb(223, 220, 38);
    height:100px;
    width: 70px;
    position:absolute;
    left:60%;
    border-radius:10px;
}
.propeller1{
    background-color:rgb(0, 0, 0);
    height:18px;
    width:50px;
    position:absolute;
    left:75px;
    top:-10px;
    border-radius:100px;
    transition: width 5s;
}
.propeller2{
    background-color:rgb(0, 0, 0);
    height:18px;
    width:50px;
    position:absolute;
    right:-76px;
    top:-10px;
    border-radius:100px;
    transition: width 5s;
}
.eyes1{
    transition: top 5s;
}
.A:hover .propeller1{
    width:200px;
}
.A:hover .propeller2{
    width:200px;
    right:-75px;
}
.A:hover .eye1{
    top:-2%;
}
.A:hover .eye2{
    top:-2%;
}
.A:hover .mouth{
    top:35%;
}
.D{
    animation-name:fly;
    animation-duration:10s;
    animation-iteration-count: infinite;
}
.D1{
    animation-name:propellerD1;
    animation-duration: 0.3s;
    animation-iteration-count: infinite;
}
.D2{
    animation-name:propellerD2;
    animation-duration: 0.3s;
    animation-iteration-count: infinite;
}
@keyframes fly {
  0% {right:0px; right:0px; bottom:0px;}
  50%{ right:500px; bottom:800px;}
  50.1%{ right:0px; bottom:900px;}
  100% {right:0px; right:0px; bottom:0px;}
}
@keyframes propellerD1{
0%{width:100px;}
50%{width:0px;}
100%{width:100px}
}
@keyframes propellerD2{
0%{width:100px;}
50%{width:0px;}
100%{width:100px}
}

/** end of emoji 1 **/



