}

.B:hover .mouth2{
    height:80px;
    width:110px;
}
.B:hover .eye3{
    width:70px;
    height:70px;
    top:13%;
}
.B:hover .eye4{
    width:70px;
    height:70px;
    top:13%;
}
.E{
    animation-name:spinny;
    animation-duration: 5s;
    animation-iteration-count: infinite;
}
.E1{    
    animation-name:rainbow;
    animation-duration: 5s;
    animation-iteration-count: infinite;
}
.E2{    
    animation-name:rainbow;
    animation-duration: 5s;
    animation-iteration-count: infinite;
}
