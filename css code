    0%{}
    7%{background-image:none;background-color:red;}
    20%{background-image:none;background-color:orange;}
    40%{background-image:none;background-color:yellow;}
    60%{background-image:none;background-color:green;}
    80%{background-image:none;background-color:blue;}
    93%{background-image:none;background-color:purple;}
    100%{}
}
 /** end of emoji 2**/



/** emoji 3 **/
.emoji3{
    display:flex;
    position:relative;
    width:250px;
    height:250px;
}
.face3{
    position:relative;
    margin:auto;
    display:flex;
    flex-direction:column;
    height:200px;
    width:200px;
    overflow:hidden;
    background-image: linear-gradient(rgb(22, 0, 224), white);
    border-color:black;
    border-radius:50%;
    box-shadow:30px 30px 35px rgba(0,0,0,0.25);
    transition: height 3s, background-image 3s;
}
.face3::before{
    content:"";
    position:absolute;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background-image:linear-gradient(rgb(0, 0, 0),rgb(255, 255, 255)); 
    transition: top 3s, transform 3s, left 3s, border 3s, opacity 3s;
    opacity: 0;
}
.C:hover .face3::before{
    opacity: 1;
}
.eye5{
    left: 10%;
    background-image:radial-gradient(white, white, white, black, black);
    transition:height 3s, width 3s;
}
.eye6{
    right:10%;
    background-image:radial-gradient(white, white, white, black, black);
    transition:height 3s, width 3s;
}
.mouth3{
    background-image:radial-gradient(rgb(75, 75, 77), black);
    width:50px;
    height:80px;
    margin:auto;
    left:0;
    right:0;
    top:50%;
    border-radius:50px;
    position:absolute;
    transition: height 3s;
}
.hand{
    display:flex;
    flex-direction:row;
    height:90px;
    width:60px;
    background-image:linear-gradient(rgb(30, 32, 155), rgb(177, 177, 177));
    position:absolute;
}

.handL{
    border-radius:25px 200px 100px 100px;
    left:10%;
    top:60%;
    transition: top 3s, transform 3s, left 3s, background-image, background-color 3s;
    overflow: hidden;
}

.handL::before{
    content:"";
    position:absolute;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background-image:linear-gradient(rgb(0, 0, 0),rgb(255, 255, 255)); 
    transition: top 3s, transform 3s, left 3s, opacity 3s;
    opacity: 0;
}
.C:hover .handL::before{
    opacity: 1;
}

.handR{
    border-radius:200px 25px 100px 100px;
    right:10%;
    top:60%;
    transition: top 3s, transform 3s, right 3s, opacity 3s;
    overflow:hidden;
}

.handR::before{
    content:"";
    position:absolute;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background-image:linear-gradient(rgb(0, 0, 0),rgb(255, 255, 255)); 
    transition: top 3s, transform 3s, left 3s, opacity 3s;
    opacity: 0;
}
.C:hover .handR::before{
    opacity: 1;
}
.C:hover .handL{
    top:50%;
    transform: rotate(8deg);
    left:5px;
} 
.C:hover .handR{
    top:50%;
    transform: rotate(-8deg);
    right:5px;
}
.C:hover .mouth3{
    height:150px;
}
.C:hover .eye5{
    height:70px;
    width:60px;
}
.C:hover .eye6{
    height:70px;
    width:60px;
}
.C:hover .face3{
    height:250px;
}

.face3{
    animation-name:scared;
    animation-duration:3s;
    animation-iteration-count: infinite;
}
@keyframes scared{
  0% {right:0px; right:0px; bottom:0px;}
  100%{ right:0px; bottom:100px; height:50px; width:50px;}
}


 /** end of emoji 3 **/
 


 
